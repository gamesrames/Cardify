# Copie para .env.local (esse arquivo fica fora do Git) e preencha com os valores do painel do
# Supabase: Project Settings → API (Project URL e a chave "publishable"/anon).
# A chave publishable é feita para ficar no app; NUNCA coloque aqui a "service_role" nem a do Gemini.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# "true" mostra a lista de categorias (classificador manual do servidor).
# Com o Gemini ligado no servidor, use "false": o servidor identifica a foto sozinho.
EXPO_PUBLIC_MANUAL_CATEGORY=true
